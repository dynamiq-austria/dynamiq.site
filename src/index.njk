---
layout: layouts/base.njk
title: "dynamiq. – Data Intelligence, OSINT & Monitoring"
pagination:
  data: homePages
  size: 1
  alias: localized
permalink: "{{ localized.permalink }}"
eleventyComputed:
  description: "{{ localized.description }}"
  ogDescription: "{{ localized.ogDescription }}"
  pageLang: "{{ localized.lang }}"
  alternatePage: "{{ localized.alternatePage }}"
ogImage: /assets/og/og-image-data-intelligence.png
isHome: true
showNavigation: true
---
{% set home = localized.home %}
{% set ui = i18n[localized.lang] %}
{% set copy = ui.home %}
<section class="poster-hero" id="top" data-poster-hero aria-labelledby="poster-title">
  <div class="poster-hero__grid" aria-hidden="true"></div>
  <div class="poster-hero__draw-surface" data-draw-surface aria-hidden="true">
    <canvas class="poster-hero__draw-canvas" data-draw-canvas></canvas>
    <span class="poster-hero__draw-hint" data-draw-hint>Make your mark.</span>
  </div>
  <p class="poster-hero__eyebrow" data-hero-reveal>SOCIAL · WEB · VIDEO · DATA</p>

  <h1 class="poster-title" id="poster-title" aria-label="FROM DATA TO CLEAR SIGNALS. BETTER DECISIONS.">
    <span class="poster-title__group poster-title__group--complex" data-hero-reveal data-depth="0.35">
      <span>FROM&nbsp;DATA </span>
      <span class="poster-title__outline">TO</span>
    </span>
    <span class="poster-title__group poster-title__group--clear" data-hero-reveal data-depth="0.62">
      <span>Clear</span>
      <span class="poster-title__serif">Signals.</span>
    </span>
    <span class="poster-title__group poster-title__group--better" data-hero-reveal data-depth="0.45">
      <span>Better</span>
      <span>DECISIONS.</span>
    </span>
  </h1>

  <div class="poster-objects" aria-label="{{ copy.posterObjectsAria }}">
    <div class="poster-object poster-object--positioning" data-poster-object data-depth="0.9" data-hero-reveal>
      <div class="poster-object__face">
        <span class="poster-object__index">01</span>
        <strong data-sticker-text>COLLECT THE DATA</strong>
        <span class="poster-object__note">SOCIAL + PUBLIC WEB</span>
      </div>
    </div>
    <div class="poster-object poster-object--story" data-poster-object data-depth="1.15" data-hero-reveal>
      <div class="poster-object__face">
        <span class="poster-object__index">02</span>
        <strong data-sticker-text>VIDEO BECOMES DATA</strong>
        <span class="poster-object__note">TRANSCRIBE + STRUCTURE</span>
      </div>
    </div>
    <div class="poster-object poster-object--growth" data-poster-object data-depth="0.75" data-hero-reveal>
      <div class="poster-object__face">
        <span class="poster-object__index">03</span>
        <strong data-sticker-text>CONNECT NETWORKS</strong>
        <span class="poster-object__note">ANALYZE + MONITOR</span>
      </div>
    </div>
  </div>

  <div class="poster-hero__footer" data-hero-reveal>
    <a class="poster-hero__cta" href="#kontakt">{{ copy.heroCta }} <span aria-hidden="true">↗</span></a>
    <a class="poster-hero__scroll" href="#datenquellen">{{ copy.heroScroll }} <span aria-hidden="true">↓</span></a>
  </div>
</section>

<section class="impact-metrics" aria-label="{{ copy.metricsAria }}">
  <dl class="impact-metrics__list">
    {% for metric in home.metrics %}
      <div class="impact-metrics__item">
        <dt>{{ metric.label }}</dt>
        <dd>
          <span class="sr-only">{{ metric.display }}+</span>
          <span class="impact-metrics__value" aria-hidden="true">
            <span class="impact-metrics__digits">
              <span class="impact-metrics__reserve">{{ metric.display }}</span>
              <span class="impact-metrics__number" data-count-target="{{ metric.target }}"{% if metric.suffix %} data-count-suffix="{{ metric.suffix }}"{% endif %}>{{ metric.display }}</span>
            </span>
            <span class="impact-metrics__plus">+</span>
          </span>
        </dd>
      </div>
    {% endfor %}
  </dl>
</section>

<section class="deliverables" id="leistungen" aria-labelledby="deliverables-title">
  <div class="deliverables__inner section-shell">
    <header class="deliverables__intro">
      <p class="section-kicker">[ {{ copy.deliverablesKicker }} ]</p>
      <div class="deliverables__heading">
        <h2 id="deliverables-title">{{ copy.deliverablesHeadingStart }} <span>{{ copy.deliverablesHeadingAccent }}</span></h2>
      </div>
    </header>

    <ol class="deliverables__grid" aria-label="{{ copy.deliverablesAria }}">
      {% for deliverable in home.deliverables %}
        <li class="deliverable">
          <header class="deliverable__header">
            <span class="deliverable__number" aria-hidden="true">{{ deliverable.number }}</span>
            <p class="deliverable__label">{{ deliverable.label }}</p>
          </header>
          <p class="deliverable__text">{{ deliverable.text }}</p>
          <div class="deliverable__outputs">
            <p class="deliverable__outputs-title">{{ copy.outputs }}</p>
            <ul>
              {% for output in deliverable.outputs %}<li>{{ output }}</li>{% endfor %}
            </ul>
          </div>
          {% if deliverable.href %}<a class="text-link deliverable__link" href="{{ deliverable.href }}">{{ deliverable.linkLabel }} <span aria-hidden="true">↗</span></a>{% endif %}
        </li>
      {% endfor %}
    </ol>
  </div>
</section>

<section class="buyer-fit" id="einsatzfelder" aria-labelledby="buyer-fit-title">
  <div class="buyer-fit__inner section-shell">
    <header class="buyer-fit__intro">
      <p class="section-kicker">[ {{ home.buyerFit.kicker }} ]</p>
      <h2 id="buyer-fit-title">{{ home.buyerFit.heading }}</h2>
      <p>{{ home.buyerFit.intro }}</p>
    </header>

    <ol class="buyer-fit__grid" aria-label="{{ home.buyerFit.areasLabel }}">
      {% for area in home.buyerFit.areas %}
        <li class="buyer-fit-card">
          <header class="buyer-fit-card__header">
            <span aria-hidden="true">[ {{ area.number }} ]</span>
            <p>{{ area.category }}</p>
          </header>
          <h3>{{ area.question }}</h3>
          <div class="buyer-fit-card__questions">
            <p>{{ home.buyerFit.questionsLabel }}</p>
            <ul>
              {% for question in area.questions %}<li>{{ question }}</li>{% endfor %}
            </ul>
          </div>
        </li>
      {% endfor %}
    </ol>

    <aside class="buyer-fit__cta" aria-labelledby="buyer-fit-cta-title">
      <div>
        <h3 id="buyer-fit-cta-title">{{ home.buyerFit.ctaHeading }}</h3>
        <p>{{ home.buyerFit.ctaText }}</p>
      </div>
      <a class="button button-light" href="#kontakt">{{ home.buyerFit.ctaLabel }} <span aria-hidden="true">↗</span></a>
    </aside>
  </div>
</section>

<section class="references" id="referenzen" aria-labelledby="references-title">
  <div class="references__inner section-shell">
    <header class="references__intro">
      <p class="section-kicker">[ {{ copy.referencesKicker }} ]</p>

      <h2 id="references-title"><span>{{ copy.referencesHeadingStart }} </span><span>{{ copy.referencesHeadingAccent }}</span></h2>
    </header>
    <ol class="reference-list">
      {% for reference in home.references %}
        <li class="reference-row">
          <span class="reference-row__number" aria-hidden="true">{{ reference.number }}</span>
          <div class="reference-row__source">
            <p>{{ reference.source }}</p>
            <strong>{{ reference.metric }}</strong>
          </div>
          <div class="reference-row__body">
            <h3>{{ reference.title }}</h3>
            <p>{{ reference.text }}</p>
            {% if reference.detail %}<p class="reference-row__detail">{{ reference.detail }}</p>{% endif %}
            {% if reference.tags %}<ul class="build-tag-list" aria-label="{{ copy.skillsAria }}">{% for tag in reference.tags %}<li>{{ tag }}</li>{% endfor %}</ul>{% endif %}
            <div class="reference-row__actions">
              {% if reference.report %}<a class="button button-dark reference-row__report" href="#report-download" data-report-open aria-haspopup="dialog">{{ copy.reportCta }}</a>{% endif %}
              {% if reference.url %}<a class="reference-row__link" href="{{ reference.url }}" target="_blank" rel="noopener noreferrer">{{ copy.articleLink }} <span aria-hidden="true">↗</span></a>{% endif %}
            </div>
          </div>
        </li>
      {% endfor %}
    </ol>
  </div>
</section>

<section class="report-feature" aria-labelledby="report-feature-title">
  <div class="report-feature__inner section-shell">
    <p class="section-kicker">[ {{ copy.reportKicker }} ]</p>

    <div class="report-feature__layout">
      <div class="report-feature__signal" aria-label="{{ copy.reportSignalAria }}">
        <span>{{ copy.reportSignalLabel }}</span>
        <strong>{{ copy.reportSignalValue }}</strong>
        <p>{{ copy.reportSignalUnit }}</p>
      </div>

      <div class="report-feature__copy">
        <h2 id="report-feature-title"><span>{{ copy.reportTitleStart }}</span><span>{{ copy.reportTitleAccent }}</span></h2>
        <p class="report-feature__lead">{{ copy.reportLead }}</p>
        <p>{{ copy.reportText }}</p>
        <a class="button button-light report-feature__button" href="#report-download" data-report-open aria-haspopup="dialog">{{ copy.reportCta }}</a>
      </div>
    </div>
  </div>
</section>

<div class="report-modal" id="report-download" data-report-modal hidden>
  <div class="report-modal__backdrop" data-report-backdrop aria-hidden="true"></div>
  <section
    class="report-modal__dialog"
    data-report-dialog
    role="dialog"
    aria-modal="true"
    aria-labelledby="report-modal-title"
    aria-describedby="report-modal-description"
    tabindex="-1"
  >
    <button class="report-modal__close" type="button" data-report-close aria-label="{{ copy.modalClose }}">
      <span aria-hidden="true">×</span>
    </button>

    <div class="report-modal__accent" aria-hidden="true">[ 03 ]</div>

    <div class="report-modal__content" data-report-form-state>
      <p class="report-modal__eyebrow">{{ copy.reportKicker }}</p>
      <h2 id="report-modal-title">{{ copy.modalTitle }}</h2>
      <p id="report-modal-description" class="report-modal__description">{{ copy.modalDescription }}</p>

      <form
        class="report-form"
        name="market-signal-report"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        data-report-form
      >
        <input type="hidden" name="form-name" value="market-signal-report">
        <p class="form-honeypot" hidden>
          <label>{{ copy.honeypot }} <input name="bot-field" type="text"></label>
        </p>
        <input type="hidden" name="report" value="market_signal_report">

        <div class="field">
          <label for="report-email">{{ copy.emailLabel }} <span aria-hidden="true">*</span></label>
          <input id="report-email" name="email" type="email" placeholder="name@company.com" autocomplete="email" required>
        </div>

        <div class="consent-field report-form__consent">
          <input id="report-consent" name="consent" type="checkbox" value="yes" required>
          <label for="report-consent">{{ copy.consentPrefix }} <a href="{{ ui.privacyPath }}">{{ copy.privacyLink }}</a>. <span aria-hidden="true">*</span></label>
        </div>

        <p class="report-form__privacy">{{ copy.noSpam }}</p>
        <p class="report-form__error" data-report-error role="alert" tabindex="-1" hidden>{{ copy.reportError }}</p>
        <button class="button button-dark report-form__submit" type="submit" data-report-submit data-loading-label="{{ copy.reportLoading }}">{{ copy.reportCta }}</button>
      </form>
    </div>

    <div class="report-success" data-report-success hidden>
      <p class="report-modal__eyebrow">{{ copy.reportKicker }}</p>
      <h2 id="report-success-title" tabindex="-1" data-report-success-title>{{ copy.successTitle }}</h2>
      <p id="report-success-description">{{ copy.successText }}</p>
      <div class="report-success__actions">
        <a class="button button-dark" href="/assets/pdfs/market_signal_report.pdf" target="_blank" rel="noopener noreferrer">{{ copy.pdfCta }}</a>
        <button class="report-success__close" type="button" data-report-close>{{ copy.close }}</button>
      </div>
    </div>
  </section>
</div>


<section class="data-sources" id="datenquellen" aria-labelledby="data-sources-title">
  <div class="data-sources__inner section-shell">
    <header class="data-sources__intro">
      <p class="section-kicker">[ {{ copy.sourcesKicker }} ]</p>
      <div class="data-sources__heading">
        <h2 id="data-sources-title">{{ copy.sourcesHeadingStart }} <span>{{ copy.sourcesHeadingAccent }}</span></h2>
      </div>
    </header>

    {% include "components/source-landscape.njk" %}

    <p class="data-sources__connection"><span>{{ copy.sourceConnectionLead }}</span> {{ copy.sourceConnectionText }}</p>
  </div>
</section>

<section class="about-team section-shell" id="team" aria-labelledby="team-title">
  <header class="about-team__intro">
    <p class="section-kicker">[ {{ copy.teamKicker }} ]</p>
    <h2 id="team-title"><span>{{ copy.teamHeadingStart }}</span><span>{{ copy.teamHeadingAccent }}</span></h2>
    <p>{{ copy.teamIntro }}</p>
  </header>
  <ol class="team-grid">
    {% for person in home.team %}
      <li class="team-card">
        <div class="team-card__media">
          {% if person.image %}
            <img src="{{ person.image }}" alt="{{ person.imageAlt }}" width="500" height="500" loading="lazy" style="object-position: {{ person.imagePosition }};">
          {% else %}
            <div class="team-card__placeholder" role="img" aria-label="{{ copy.placeholderFor }} {{ person.name }}">
              <strong>{{ person.placeholder }}</strong>
              <span>{{ copy.portraitFollows }}</span>
            </div>
          {% endif %}
        </div>
        <div class="team-card__content">
          <div class="team-card__meta"><span aria-hidden="true">[ {{ person.number }} ]</span>{% if person.badge or person.status %}<strong>{{ person.badge or person.status }}</strong>{% endif %}</div>
          <h3>{{ person.name }}</h3>
          <p class="team-card__role">{{ person.role }}</p>
          <p class="team-card__focus">{{ person.disciplines }}</p>
          <p class="team-card__description">{{ person.text }}</p>
        </div>
      </li>
    {% endfor %}
  </ol>
</section>

<section class="contact" id="kontakt" aria-labelledby="contact-title">
  <div class="contact__inner section-shell">
    <header class="contact-intro">
      <p class="section-kicker">[ {{ copy.contactKicker }} ]</p>
      <h2 id="contact-title"><span>{{ copy.contactHeadingStart }}</span><span>{{ copy.contactHeadingAccent }}</span></h2>
    </header>
    <div class="contact-body">
      <div class="contact-summary">
        <p>{{ copy.contactIntroOne }}</p>
        <p>{{ copy.contactIntroTwo }}</p>
        <div class="contact-meta">
          <p class="contact-direct"><span>{{ copy.directEmail }}</span><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
        </div>
      </div>

      {% include "components/contact-form.njk" %}
    </div>
  </div>
</section>
